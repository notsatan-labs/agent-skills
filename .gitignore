# Thanks Apple
.DS_Store

# Cache folder generated by IDE
.vscode
.idea
__pycache__
*.egg-info

# Virtual environment(s)
.venv
venv

# Ignore directories containing binaries generated and other stuff
tmp/*
bin/*
coverage/*

# Directories require atleast one file to be tracked by git.
!tmp/.gitkeep
!bin/.gitkeep
!coverage/.gitkeep

# Ignore config files from project root, while keeping the sample config files
/configs**
!/configs.**.sample

# Ignore any password files
**.password
password.**

# Auto-generated host connection files (contain SSH keys and passwords)
host_vars/
